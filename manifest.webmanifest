{
  "name": "আজকের খরচ · Ajker Khoroch",
  "short_name": "আজকের খরচ",
  "description": "রোজ জানুন আজ কত টাকা নিশ্চিন্তে খরচ করা যায়। Know how much you can safely spend today.",
  "lang": "bn",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4ef",
  "theme_color": "#1f5f5b",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {"name": "statement", "accept": ["application/pdf", ".pdf", "text/csv", ".csv", "application/vnd.ms-excel", ".xls", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", ".xlsx", "application/octet-stream"]}
      ]
    }
  }
}
